# Copy to .env and adjust. All values are optional unless noted.

# Browser origins allowed to call this API (comma-separated, no trailing slash).
# Add your Vercel URL after deploying the frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Currency the ANN predicts in. The target scaler (mean ~3,939, std ~3,990)
# matches the USD diamonds dataset. Use INR only if your model outputs rupees;
# in that case no conversion is applied.
MODEL_OUTPUT_CURRENCY=USD

# Live rate cache lifetime and request timeout.
EXCHANGE_RATE_TTL_SECONDS=21600
EXCHANGE_RATE_TIMEOUT_SECONDS=6

# Used ONLY if every live source fails and no rate has been fetched yet.
# It is always labelled as a fallback in the API and UI. Update it from time to
# time; the date is shown to users. (INR settled at 94.58 per USD on 2026-11-04.)
FALLBACK_USD_INR=94.58
FALLBACK_RATE_DATE=2026-11-04
